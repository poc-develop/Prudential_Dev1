# Set default behavior to automatically normalize line endings
* text=auto

# Force LF line endings for specific file types
*.js text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.cls text eol=lf
*.cmp text eol=lf
*.css text eol=lf
*.html text eol=lf
*.js text eol=lf
*.svg text eol=lf
*.page text eol=lf
*.component text eol=lf

# Force CRLF for Windows-specific files
*.bat text eol=crlf
*.cmd text eol=crlf
